<Project>

  <PropertyGroup Label="Target framework and build outputs">
    <TargetFramework>net10.0</TargetFramework>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <IncludeProjectNameInArtifactsPaths>true</IncludeProjectNameInArtifactsPaths>
    <UseArtifactsIntermediateOutput>true</UseArtifactsIntermediateOutput>

    <!-- WHY: With artifacts output, legacy project-local bin/obj folders and BenchmarkDotNet's
         working-directory artifacts are no longer covered by the default excludes. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**;**/BenchmarkDotNet.Artifacts/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Label="Compiler and analysis">
    <LangVersion>latestMajor</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Label="Dependency restore and audit">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- WHY: Locally, NuGet updates the locks and the change shows up in the diff. CI enforces them.
         RID-specific restores need packages that the platform-neutral locks do not record. -->
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true' and '$(RuntimeIdentifier)' == ''">true</RestoreLockedMode>

    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <!-- WHY: Newly published advisories or an unreachable audit source must not fail regular builds
         without a source change. A dedicated audit run promotes them with -p:DokaAuditPipeline=true. -->
    <DokaNuGetAuditCodes>NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</DokaNuGetAuditCodes>
    <WarningsAsErrors Condition="'$(DokaAuditPipeline)' == 'true'">$(WarningsAsErrors);$(DokaNuGetAuditCodes)</WarningsAsErrors>
    <WarningsNotAsErrors Condition="'$(DokaAuditPipeline)' != 'true'">$(WarningsNotAsErrors);$(DokaNuGetAuditCodes)</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="CI and release isolation">
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Project defaults">
    <!-- WHY: Tests, benchmarks and samples are build-only; src/Directory.Build.props enables packages and XML docs. -->
    <IsPackable>false</IsPackable>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
